# Canonical generated result tree: only curated CSVs and figures are eligible.
# Inspect sizes/content before git add. Do not commit SQLite/NPZ/checkpoints.
# The folders are deliberately NOT ignored: selected outputs can be tracked.
# Ignore everything under results by default, selectively include small exports.
/analysis_results/*
!/analysis_results/*/
/analysis_results/*/*
!/analysis_results/*/replicates.csv
!/analysis_results/*/summary.csv
!/analysis_results/*/figures/
/analysis_results/*/figures/*
!/analysis_results/*/figures/*.png
!/analysis_results/*/figures/*.pdf

